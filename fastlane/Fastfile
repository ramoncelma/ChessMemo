default_platform(:ios)

APP_IDENTIFIER = "app.chessmemo.ChessMemo"
PROJECT = "ChessMemo.xcodeproj"
SCHEME = "ChessMemo"

platform :ios do
  desc "Build a signed app and upload it to TestFlight"
  lane :beta do
    # 1. Log in to App Store Connect using the API key (stored as GitHub secrets).
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    # 2. Generate the Xcode project from project.yml.
    sh("which xcodegen >/dev/null 2>&1 || brew install xcodegen")
    Dir.chdir("..") { sh("xcodegen", "generate") }

    # 3. Fetch (or create) the signing certificate + provisioning profile.
    #    These are stored encrypted in a branch of this same repo, so you do
    #    not need a Mac or a second repository.
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      readonly: false
    )

    # 4. Switch the project to manual signing using the profile match created.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      targets: [SCHEME],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"],
      team_id: ENV["sigh_#{APP_IDENTIFIER}_appstore_team-id"]
    )

    # 5. Build the signed .ipa. The build number is the GitHub run number so
    #    every upload has a unique, increasing value (TestFlight requires this).
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    )

    # 6. Upload the .ipa to TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
